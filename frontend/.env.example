# NEXA Frontend
# Copy this file to .env.local and set values as needed.

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser requests use the same-origin proxy by default. Leave empty in
# production and configure NEXA_BACKEND_URL as a server-only environment variable.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
# NEXA_BACKEND_URL=https://api.example.com

# Local preview only. Never enable this in production.
NEXT_PUBLIC_ENABLE_DEV_WALLET=false

# WalletConnect Cloud project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# BSC Testnet
NEXT_PUBLIC_BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# Smart contracts (set after deployment)
NEXT_PUBLIC_NEXA_IDENTITY_ADDRESS=
NEXT_PUBLIC_NEXA_JOURNAL_ADDRESS=

# Preview mode (optional)
NEXT_PUBLIC_DEFAULT_DEV_WALLET=0xb461205ea2392497d2d59efef6ff3928e3630a0b

# Build analysis (optional; used by `npm run analyze`)
ANALYZE=false
