# ============================================
# NEXA CONTRACTS (Foundry) — Environment Variables
# ============================================
# Copy this file to .env before deploying contracts:
# cp .env.example .env

# Deployer Private Key (TANPA prefix 0x) — JANGAN PERNAH COMMIT PRIVATE KEY ASLI KE GIT!
PRIVATE_KEY=your_deployer_private_key_without_0x

# BSC Testnet RPC Endpoint
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# BSC Mainnet RPC Endpoint
BSC_MAINNET_RPC=https://bsc-dataseed.bnbchain.org

# BscScan API Key for contract verification
BSCSCAN_API_KEY=your_bscscan_api_key_here
