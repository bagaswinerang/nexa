# NEXA Contracts (Foundry)
# Copy this file to .env before deploying or verifying contracts.

# Deployer private key (without 0x). Never commit a real private key.
PRIVATE_KEY=

# BSC Testnet RPC
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# BscScan API key (required only for verification)
BSCSCAN_API_KEY=
